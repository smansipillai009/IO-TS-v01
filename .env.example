# Where cutouts, PNGs, the SQLite DB and the cache live
DATA_DIR=./data
# CORS: the Next.js app proxies /api, so this is only needed for direct browser calls
CORS_ORIGINS=http://localhost:3000
# Limits (keep MAX_RADIUS_DEG in sync with frontend/src/lib/constants.ts)
MAX_RADIUS_DEG=0.5
MAX_FRAMES=24
MAX_EST_MB=150
# Archive endpoints (VERIFY on Day 1 with scripts/day1_spike.py)
IRSA_SIA_URL=https://irsa.ipac.caltech.edu/SIA
IRSA_SIA_COLLECTION=spherex_qr
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
# Bump DATA_RELEASE when IRSA ships a new release; derived products are rebuilt, nothing else changes
DATA_RELEASE=spherex_qr
PIPELINE_VERSION=0.1.0
# Wavelength tolerance for "comparable" frames (fraction). Must match frontend WAVELENGTH_TOL_FRAC
WAVELENGTH_TOL_FRAC=0.02
# Alignment residual thresholds in pixels
ALIGN_GOOD_PX=0.5
ALIGN_DEGRADED_PX=1.5
# Bitmask of FLAGS bits treated as bad. Default: any non-zero flag. REFINE after reading the SPHEREx flag table.
FLAG_MASK_BITS=4294967295
WORKERS=2
# Appended to the uri to request a cutout (size_deg = full field width in degrees)
CUTOUT_QUERY=center={ra},{dec}d&size={size_deg}
# live = real pipeline behind POST /api/investigations; static = only the stored demo field in ./products
INVESTIGATION_MODE=live
# Cutouts downloaded to find same-wavelength frames (MAX_FRAMES is only how many are shown)
MAX_POOL=40
# Folder of processed products served as /products/<id>/ (see products/README.md)
DEMO_PRODUCTS_DIR=./products
